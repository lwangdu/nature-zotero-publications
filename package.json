{
	"name": "publications-list-display-for-zotero",
	"version": "1.0.7",
	"description": "Display live Zotero library data as a searchable, filterable Gutenberg bibliography.",
	"private": true,
	"scripts": {
		"build": "wp-scripts build --experimental-modules",
		"start": "wp-scripts start --experimental-modules",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"test:js": "node tests/request-url.cjs",
		"test:php": "php tests/response-redaction.php && php tests/sync-diagnostics.php && php tests/audit-regressions.php",
		"plugin-zip": "wp-scripts plugin-zip",
		"packages-update": "wp-scripts packages-update"
	},
	"files": [
		"build/",
		"includes/",
		"src/",
		"publications-list-display-for-zotero.php",
		"uninstall.php",
		"README.md",
		"readme.txt",
		"LICENSE"
	],
	"devDependencies": {
		"@wordpress/scripts": "^30.0.0",
		"@wordpress/interactivity": "^6.54.0"
	},
	"license": "GPL-2.0-or-later"
}
